# Porta e indirizzo di ascolto
PORT=3000
HOST=0.0.0.0

# Dove il server salva i documenti (monta qui un volume persistente nel cloud)
DATA_DIR=./data

# Se impostata, serve per sincronizzare e per usare l'AI. CONSIGLIATA se esponi il server su internet.
APP_PASSWORD=

# Facoltativo: abilita l'assistente AI online (Claude). Senza chiave l'assistente locale funziona comunque.
ANTHROPIC_API_KEY=
# Modello usato per generare gli ambienti (default: claude-opus-5-5)
AI_MODEL=
